# ===== Anchor namespaces: real discriminator structure =====
# `type` is the conventional discriminator (5425 observations on a
# 9000-row walk) far more often than `entity_type` (185). Attributes
# are scoped per (project, type-value) pair, not per project.
arkv:ns_mandi_board_v1 a arkiv:Project ;
    arkiv:canonicalName "mandi_board_v1" ;
    arkiv:discriminator "type" ;
    arkiv:observationCount 97 .
arkv:nsType_mandi_board_v1_price_report a arkiv:EntityType ;
    arkiv:belongsToProject "mandi_board_v1" ;
    arkiv:canonicalName "price_report" ;
    arkiv:observationCount 63 ;
    arkiv:attributeName "crop", "mandi", "price", "project", "reported_at_ms", "reporter", "state", "synthetic", "type" .
arkv:nsType_mandi_board_v1_price_vote a arkiv:EntityType ;
    arkiv:belongsToProject "mandi_board_v1" ;
