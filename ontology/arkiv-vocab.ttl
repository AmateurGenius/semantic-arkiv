@prefix arkiv:  <https://semantic-arkiv.dev/ontology/arkiv#> .
@prefix arkv:  <https://semantic-arkiv.dev/ontology/arkiv/vocab#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .

arkv:ArkivVocabularyOntology a owl:Ontology ;
    dct:title "Arkiv Vocabulary Ontology" ;
    dct:description "A live-derived catalogue of the Arkiv Tiramisu entity vocabulary. Every individual is traceable to an observation captured by a real arkiv_query walk." ;
    owl:versionInfo "1.0.0" ;
    dct:source <https://rpc.tiramisu.db-chain.testnet.arkiv.network> ;
    dct:created "2026-10-18"^^xsd:date ;
    arkiv:chainId 7738577 ;
    arkiv:sdkVersion "0.8.1" ;
    arkiv:derivedFrom "live-tiramisu-scan" ;
    arkiv:observedRows 3773 ;
    arkiv:observedProjects 37 ;
    arkiv:observedEntityTypes 100 ;
    arkiv:observedAttributes 415 ;
    arkiv:observedAmbiguousAttributes 20 .

arkiv:Project a owl:Class ; rdfs:comment "An Arkiv project namespace (the `project` attribute value)." .
arkiv:EntityType a owl:Class ; rdfs:comment "A discovered `entity_type` value." .
arkiv:Attribute a owl:Class ; rdfs:comment "A discovered application attribute name." .
arkiv:AmbiguousAttribute a owl:Class ; rdfs:comment "An attribute name observed carrying more than one Arkiv type across projects." .
arkiv:GrammarRule a owl:Class ; rdfs:comment "A syntax rule the node enforces, established by live probe." .
arkiv:GrammarRejection a owl:Class ; rdfs:comment "A syntax construct the node rejects, with its error code and message." .

# ===== Grammar rejections (empirically confirmed) =====
arkv:rule_symbol_operators a arkiv:GrammarRejection ;
    rdfs:label "symbol-operators" ;
    arkiv:nodeErrorCode -32001 ;
    arkiv:nodeMessage "symbol operators (&& || ~) were removed — use AND, OR, STARTSWITH" ;
    arkiv:rationale "The plan's example filter used && and ||. Both are removed." .
arkv:rule_bang_negation a arkiv:GrammarRejection ;
    rdfs:label "bang-negation" ;
    arkiv:nodeErrorCode -32001 ;
    arkiv:nodeMessage "unexpected '!' — negation is written NOT" ;
    arkiv:rationale "C-style negation removed." .
arkv:rule_not_equals a arkiv:GrammarRejection ;
    rdfs:label "not-equals" ;
    arkiv:nodeErrorCode -32002 ;
    arkiv:nodeMessage "!= is not part of the query language — write NOT (attr = value) for that" ;
    arkiv:rationale "ne() is exported by the SDK but rejected by the node." .
arkv:rule_exists a arkiv:GrammarRejection ;
    rdfs:label "exists" ;
    arkiv:nodeErrorCode -32002 ;
    arkiv:nodeMessage "exists(…) is not supported — the index has no per-attribute presence scan" ;
    arkiv:rationale "SDK exports exists() but the node rejects it." .
arkv:rule_typeof a arkiv:GrammarRejection ;
    rdfs:label "typeof" ;
    arkiv:nodeErrorCode -32002 ;
    arkiv:nodeMessage "typeof(…) is not supported — a value predicate already asserts the attribute type" ;
    arkiv:rationale "SDK exports hasType() but the node rejects it." .
arkv:rule_like a arkiv:GrammarRejection ;
    rdfs:label "like" ;
    arkiv:nodeErrorCode -32001 ;
    arkiv:nodeMessage "expected a comparison operator (= < <= > >= STARTSWITH)" ;
    arkiv:rationale "No SQL LIKE. Prefix match is STARTSWITH." .
arkv:rule_subquery a arkiv:GrammarRejection ;
    rdfs:label "subquery" ;
    arkiv:nodeErrorCode -32001 ;
    arkiv:nodeMessage "unexpected character" ;
    arkiv:rationale "No subqueries. The plan's example used IN (SELECT ...)." .
arkv:rule_bool_wrapper a arkiv:GrammarRejection ;
    rdfs:label "bool-wrapper" ;
    arkiv:nodeErrorCode -32003 ;
    arkiv:nodeMessage "bool takes no wrapper — write the literal true or false" ;
    arkiv:rationale "bool(true) is an SDK constructor, not query syntax." .
arkv:rule_quoted_decimal a arkiv:GrammarRejection ;
    rdfs:label "quoted-decimal" ;
    arkiv:nodeErrorCode -32003 ;
    arkiv:nodeMessage "dec expects decimal digits" ;
    arkiv:rationale "dec() takes a bare literal. dec('4.5') is rejected." .
arkv:rule_bare_decimal a arkiv:GrammarRejection ;
    rdfs:label "bare-decimal" ;
    arkiv:nodeErrorCode -32001 ;
    arkiv:nodeMessage "unexpected character" ;
    arkiv:rationale "A bare 4.5 is rejected. Write dec(4.5)." .
arkv:rule_double_quoted a arkiv:GrammarRejection ;
    rdfs:label "double-quoted" ;
    arkiv:nodeErrorCode -32001 ;
    arkiv:nodeMessage "unexpected character; inside str() the node is more specific: \"str takes a single-quoted string, e.g. str('Bob')\" (-32003)" ;
    arkiv:rationale "Arkiv string literals are str('x'). Double quotes are never valid." .
arkv:rule_startswith_function a arkiv:GrammarRejection ;
    rdfs:label "startswith-function" ;
    arkiv:nodeErrorCode -32001 ;
    arkiv:nodeMessage "unexpected character" ;
    arkiv:rationale "STARTSWITH is INFIX only: attr STARTSWITH str('x')." .
arkv:rule_untagged_string a arkiv:GrammarRejection ;
    rdfs:label "untagged-string" ;
    arkiv:nodeErrorCode -32002 ;
    arkiv:nodeMessage "untagged strings are only valid for system attributes" ;
    arkiv:rationale "The right operand must be str('...')." .
arkv:rule_system_time_bare_int a arkiv:GrammarRejection ;
    rdfs:label "system-time-bare-int" ;
    arkiv:nodeErrorCode -32002 ;
    arkiv:nodeMessage "this system attribute holds u64 — write u64(0)" ;
    arkiv:rationale "System time attributes need an explicit u64() literal." .

# ===== Accepted forms =====
arkv:rule_boolean_keywords a arkiv:GrammarRule ; rdfs:label "boolean keywords" ;
    arkiv:emits "AND / OR / NOT" ;
    arkiv:rationale "Symbol operators && || ~ were removed from the language." .
arkv:rule_startswith_infix a arkiv:GrammarRule ; rdfs:label "STARTSWITH is infix" ;
    arkiv:emits "attr STARTSWITH str('prefix')   // INFIX, not a function call" ;
    arkiv:rationale "The function form STARTSWITH(a, str('x')) is rejected with -32001." .
arkv:literal_str a arkiv:GrammarRule ; rdfs:label "str literal" ;
    arkiv:emits "str('text')            // doubled apostrophe for embedded quote" .
arkv:literal_dec a arkiv:GrammarRule ; rdfs:label "dec literal" ;
    arkiv:emits "dec(4.5)               // bare digits only, never quoted" .
arkv:literal_u64 a arkiv:GrammarRule ; rdfs:label "u64 literal" ;
    arkiv:emits "u64(0)                 // bare digits only" .
arkv:literal_i32 a arkiv:GrammarRule ; rdfs:label "i32 literal" ;
    arkiv:emits "i32(10)                // bare JavaScript number" .
arkv:literal_u256 a arkiv:GrammarRule ; rdfs:label "u256 literal" ;
    arkiv:emits "u256(1250)             // bare bigint" .
arkv:literal_addr a arkiv:GrammarRule ; rdfs:label "addr literal" ;
    arkiv:emits "addr(0x...)            // hex only, no quotes" .
arkv:literal_key a arkiv:GrammarRule ; rdfs:label "key literal" ;
    arkiv:emits "key(0x...)             // 32-byte hex" .
arkv:literal_bool a arkiv:GrammarRule ; rdfs:label "bool literal" ;
    arkiv:emits "true / false           // bare literals, no wrapper" .
arkv:rule_name_grammar a arkiv:GrammarRule ; rdfs:label "attribute name grammar" ;
    arkiv:emits "lowercase snake_case; start with a letter; <=32 bytes" ;
    arkiv:rationale "camelCase and UPPERCASE names PARSE on the read path and return count=0, but the write path rejects them ('outside the name charset', Ident32InvalidByte 0x276f7798). Such a name can never match a stored cell." .
arkv:rule_silent_zero a arkiv:GrammarRule ; rdfs:label "silent-zero trap" ;
    arkiv:rationale "A query using an uppercase attribute name, or a bare numeric literal against a u64/u256/dec cell, SUCCEEDS and returns an empty set with no error. This is worse than a parse failure." .

